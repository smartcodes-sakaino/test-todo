{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nippouchou",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nippouchou-db",
      "database_id": "REPLACE_WITH_REAL_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
